---
# Fixtures cover mutable declarations, alternate comma layouts, comment
# grouping parentheses, and copies of referenced values. Renderer tests
# validate these deliberate output choices. Caller-supplied identifiers
# include intentional one-letter names; their length is not a C grammar rule.
Checks: >
  *,
  -altera-struct-pack-align,
  -cppcoreguidelines-avoid-magic-numbers,
  -fuchsia-default-arguments-calls,
  -google-objc-function-naming,
  -google-runtime-int,
  -hicpp-named-parameter,
  -llvm-include-order,
  -llvmlibc-callee-namespace,
  -llvmlibc-implementation-in-namespace,
  -llvmlibc-restrict-system-libc-headers,
  -misc-const-correctness,
  -misc-include-cleaner,
  -misc-use-internal-linkage,
  -modernize-raw-string-literal,
  -modernize-use-trailing-return-type,
  -performance-use-std-move,
  -performance-unnecessary-value-param,
  -readability-identifier-length,
  -readability-implicit-bool-conversion,
  -readability-magic-numbers,
  -readability-named-parameter,
  -readability-redundant-parentheses,
  -readability-trailing-comma,
WarningsAsErrors: '*'
