.git_archival.txt  export-subst
* text=auto eol=lf
# These goldens assert that a carriage return inside a string value
# survives.  Check-in normalization would rewrite it, so the files are
# exempt from any end-of-line conversion (issue #4514).
tests/integration/cases/string_carriage_return_line_feed/** -text
tests/integration/cases/python_raw_string_carriage_return/** -text whitespace=cr-at-eol
tests/integration/cases/single_quoted_crlf/** -text whitespace=cr-at-eol
