MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

PROC api.worker.process (VAL MOBILE LIT values, VAL MOBILE LIT count)
    SKIP
:
PROC main ()
    api.worker.process(MOBILE LIT(lit.list; MOBILE []MOBILE LIT [MOBILE LIT(lit.int; 1), MOBILE LIT(lit.map; MOBILE []MOBILE LIT [])]), MOBILE LIT(lit.int; 42))
    api.worker.process(MOBILE LIT(lit.list; MOBILE []MOBILE LIT [MOBILE LIT(lit.int; 2), MOBILE LIT(lit.map; MOBILE []MOBILE LIT [MOBILE LIT(lit.pair; MOBILE []BYTE "x"; MOBILE LIT(lit.str; MOBILE []BYTE "s"))])]), MOBILE LIT(lit.int; 43))
    SEQ
        SKIP
:
