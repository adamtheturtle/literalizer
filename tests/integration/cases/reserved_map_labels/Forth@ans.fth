: my_data
+obj
    s\" if" +key 1 +int
    s\" then" +key 2 +int
    s\" else" +key 3 +int
    s\" let" +key 4 +int
    s\" in" +key 5 +int
    s\" using" +key 6 +int
    s\" missing" +key 7 +int
    s\" assert" +key 8 +int
    s\" as" +key 9 +int
    s\" Infinity" +key 10 +int
    s\" NaN" +key 11 +int
    s\" merge" +key 12 +int
    s\" Some" +key 13 +int
    s\" toMap" +key 14 +int
    s\" forall" +key 15 +int
    s\" with" +key 16 +int
    s\" ordinary" +key 17 +int
 -obj
;
