MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

MOBILE LIT FUNCTION thing.go (VAL MOBILE LIT value)
    RESULT MOBILE LIT(lit.null)
:
PROC main ()
    VAL MOBILE LIT my_data IS thing.go(MOBILE LIT(lit.list; MOBILE []MOBILE LIT [])):
    SEQ
        SKIP
:
