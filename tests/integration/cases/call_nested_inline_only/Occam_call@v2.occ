MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

PROC f (VAL MOBILE LIT a, VAL MOBILE LIT b)
    SKIP
:
PROC main ()
    f(MOBILE LIT(lit.int; 2), MOBILE LIT(lit.str; MOBILE []BYTE "hello"))  -- trailing note
    f(MOBILE LIT(lit.int; 3), MOBILE LIT(lit.str; MOBILE []BYTE "world"))  -- another note
    SEQ
        SKIP
:
