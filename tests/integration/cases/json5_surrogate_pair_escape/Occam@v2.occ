MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

PROC main ()
    VAL MOBILE LIT my_data IS MOBILE LIT(lit.map; MOBILE []MOBILE LIT [
        MOBILE LIT(lit.pair; MOBILE []BYTE "astral"; MOBILE LIT(lit.str; MOBILE []BYTE "😀")),
        MOBILE LIT(lit.pair; MOBILE []BYTE "mixed"; MOBILE LIT(lit.str; MOBILE []BYTE "a😀b")),
        MOBILE LIT(lit.pair; MOBILE []BYTE "count"; MOBILE LIT(lit.int; 2)),
        MOBILE LIT(lit.pair; MOBILE []BYTE "list"; MOBILE LIT(lit.list; MOBILE []MOBILE LIT [MOBILE LIT(lit.str; MOBILE []BYTE "😀"), MOBILE LIT(lit.int; 1)])),
        MOBILE LIT(lit.pair; MOBILE []BYTE "nested"; MOBILE LIT(lit.map; MOBILE []MOBILE LIT [MOBILE LIT(lit.pair; MOBILE []BYTE "inner"; MOBILE LIT(lit.str; MOBILE []BYTE "😀"))]))
    ]):
    SEQ
        SKIP
:
