MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

MOBILE LIT FUNCTION make_widget (VAL MOBILE LIT count)
    RESULT MOBILE LIT(lit.null)
:
PROC consume (VAL MOBILE LIT count)
    SKIP
:
PROC main ()
    VAL MOBILE LIT my_data IS make_widget(MOBILE LIT(lit.null)):
    consume(my_data)
    my_data := make_widget(MOBILE LIT(lit.int; 42))
    consume(my_data)
    SEQ
        SKIP
:
