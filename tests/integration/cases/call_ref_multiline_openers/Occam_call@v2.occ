MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

PROC consume (VAL MOBILE LIT items, VAL MOBILE LIT mapping)
    SKIP
:
PROC main ()
    VAL MOBILE LIT foo IS 42:
    consume(MOBILE LIT(lit.list; MOBILE []MOBILE LIT [
        MOBILE LIT(lit.map; MOBILE []MOBILE LIT [
            MOBILE LIT(lit.pair; MOBILE []BYTE "other"; MOBILE LIT(lit.int; 1))
        ]),
        foo
    ]), MOBILE LIT(lit.map; MOBILE []MOBILE LIT [
        MOBILE LIT(lit.pair; MOBILE []BYTE "left"; foo),
        MOBILE LIT(lit.pair; MOBILE []BYTE "other"; MOBILE LIT(lit.int; 1))
    ]))
    SEQ
        SKIP
:
