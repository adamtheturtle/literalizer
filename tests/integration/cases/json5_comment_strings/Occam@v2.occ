MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

PROC main ()
    VAL MOBILE LIT my_data IS MOBILE LIT(lit.list; MOBILE []MOBILE LIT [
        -- strings stay data
        MOBILE LIT(lit.str; MOBILE []BYTE "https://example.org/a/*b*/"),  -- URL annotation
        MOBILE LIT(lit.str; MOBILE []BYTE "escaped quote: \" // still data"),
        MOBILE LIT(lit.str; MOBILE []BYTE "backslash: \\"),  -- outside the string
        MOBILE LIT(lit.str; MOBILE []BYTE "/* not a comment */")
    ]):
    SEQ
        SKIP
:
