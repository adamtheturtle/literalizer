    s\" error" +key 1 +int
    s\" false" +key 1 +int
    s\" for" +key 1 +int
    s\" function" +key 1 +int
    s\" if" +key 1 +int
    s\" import" +key 1 +int
    s\" importbin" +key 1 +int
    s\" importstr" +key 1 +int
    s\" in" +key 1 +int
    s\" local" +key 1 +int
    s\" null" +key 1 +int
    s\" self" +key 1 +int
    s\" super" +key 1 +int
    s\" tailstrict" +key 1 +int
    s\" then" +key 1 +int
    s\" true" +key 1 +int
    s\" ordinary" +key 1 +int
 -obj
;
