MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

PROC f (VAL MOBILE LIT ops)
    SKIP
:
PROC main ()
    f(MOBILE LIT(lit.list; MOBILE []MOBILE LIT [MOBILE LIT(lit.list; MOBILE []MOBILE LIT [MOBILE LIT(lit.str; MOBILE []BYTE "DEL"), MOBILE LIT(lit.str; MOBILE []BYTE "b"), MOBILE LIT(lit.str; MOBILE []BYTE "10")]), MOBILE LIT(lit.list; MOBILE []MOBILE LIT [MOBILE LIT(lit.str; MOBILE []BYTE "ADD"), MOBILE LIT(lit.str; MOBILE []BYTE "a"), MOBILE LIT(lit.str; MOBILE []BYTE "x")])]))  -- note
    SEQ
        SKIP
:
