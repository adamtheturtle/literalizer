MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

PROC a.foo.Foo.bar (VAL MOBILE LIT x)
    SKIP
:
PROC main ()
    a.foo.Foo.bar(MOBILE LIT(lit.list; MOBILE []MOBILE LIT [MOBILE LIT(lit.int; 1)]))
    SEQ
        SKIP
:
