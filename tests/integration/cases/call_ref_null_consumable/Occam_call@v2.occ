MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

PROC consume (VAL MOBILE LIT value)
    SKIP
:
PROC main ()
    VAL MOBILE LIT my_null IS MOBILE LIT(lit.null):
    VAL MOBILE LIT regular_null IS MOBILE LIT(lit.null):
    consume(my_null)
    consume(regular_null)
    SEQ
        SKIP
:
