MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

PROC main ()
    VAL MOBILE LIT my_data IS MOBILE LIT(lit.list; MOBILE []MOBILE LIT [
        MOBILE LIT(lit.map; MOBILE []MOBILE LIT [MOBILE LIT(lit.pair; MOBILE []BYTE "input"; MOBILE LIT(lit.map; MOBILE []MOBILE LIT [MOBILE LIT(lit.pair; MOBILE []BYTE "name"; MOBILE LIT(lit.str; MOBILE []BYTE "alice")), MOBILE LIT(lit.pair; MOBILE []BYTE "city"; MOBILE LIT(lit.str; MOBILE []BYTE "paris"))])), MOBILE LIT(lit.pair; MOBILE []BYTE "expected"; MOBILE LIT(lit.map; MOBILE []MOBILE LIT [MOBILE LIT(lit.pair; MOBILE []BYTE "count"; MOBILE LIT(lit.int; 1)), MOBILE LIT(lit.pair; MOBILE []BYTE "total"; MOBILE LIT(lit.int; 2))]))]),
        MOBILE LIT(lit.map; MOBILE []MOBILE LIT [MOBILE LIT(lit.pair; MOBILE []BYTE "input"; MOBILE LIT(lit.map; MOBILE []MOBILE LIT [MOBILE LIT(lit.pair; MOBILE []BYTE "name"; MOBILE LIT(lit.int; 10)), MOBILE LIT(lit.pair; MOBILE []BYTE "city"; MOBILE LIT(lit.int; 20))])), MOBILE LIT(lit.pair; MOBILE []BYTE "expected"; MOBILE LIT(lit.map; MOBILE []MOBILE LIT [MOBILE LIT(lit.pair; MOBILE []BYTE "count"; MOBILE LIT(lit.str; MOBILE []BYTE "done")), MOBILE LIT(lit.pair; MOBILE []BYTE "total"; MOBILE LIT(lit.str; MOBILE []BYTE "pending"))]))])
    ]):
    SEQ
        SKIP
:
