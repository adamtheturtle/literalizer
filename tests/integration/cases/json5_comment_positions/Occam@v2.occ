MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

PROC main ()
    VAL MOBILE LIT my_data IS MOBILE LIT(lit.map; MOBILE []MOBILE LIT [
        --
        -- document heading
        -- before the first entry
        -- after the key
        -- before the value
        MOBILE LIT(lit.pair; MOBILE []BYTE "counts"; MOBILE LIT(lit.list; MOBILE []MOBILE LIT [
            -- before the first item
            MOBILE LIT(lit.int; 1),  -- inline block after the comma
            -- before the second item
            MOBILE LIT(lit.int; 2)
            -- trailing inside the array
        ])),  -- after the nested collection
        MOBILE LIT(lit.pair; MOBILE []BYTE "more"; MOBILE LIT(lit.list; MOBILE []MOBILE LIT [
            MOBILE LIT(lit.int; 3),
            --
            -- block heading
            -- block continuation
            MOBILE LIT(lit.int; 4)  -- final inline
        ]))
        -- trailing inside the object
        -- after the root
        -- after the document
    ]):
    SEQ
        SKIP
:
