MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

PROC main ()
    VAL MOBILE LIT my_data IS MOBILE LIT(lit.map; MOBILE []MOBILE LIT [
        MOBILE LIT(lit.pair; MOBILE []BYTE "double"; MOBILE LIT(lit.str; MOBILE []BYTE "a     b")),
        MOBILE LIT(lit.pair; MOBILE []BYTE "single"; MOBILE LIT(lit.str; MOBILE []BYTE "c     d")),
        MOBILE LIT(lit.pair; MOBILE []BYTE "both"; MOBILE LIT(lit.str; MOBILE []BYTE "e     f     g")),
        MOBILE LIT(lit.pair; MOBILE []BYTE "continued"; MOBILE LIT(lit.str; MOBILE []BYTE "hi")),
        MOBILE LIT(lit.pair; MOBILE []BYTE "escaped backslash"; MOBILE LIT(lit.str; MOBILE []BYTE "j\\     k"))
    ]):
    SEQ
        SKIP
:
