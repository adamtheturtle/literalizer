MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

PROC main ()
    VAL MOBILE LIT my_data IS MOBILE LIT(lit.map; MOBILE []MOBILE LIT [
        MOBILE LIT(lit.pair; MOBILE []BYTE "a-b"; MOBILE LIT(lit.int; 1)),
        MOBILE LIT(lit.pair; MOBILE []BYTE "two words"; MOBILE LIT(lit.int; 2)),
        MOBILE LIT(lit.pair; MOBILE []BYTE "she said \"hi\""; MOBILE LIT(lit.int; 3)),
        MOBILE LIT(lit.pair; MOBILE []BYTE ""; MOBILE LIT(lit.int; 4)),
        MOBILE LIT(lit.pair; MOBILE []BYTE "valid_key"; MOBILE LIT(lit.int; 5))
    ]):
    SEQ
        SKIP
:
