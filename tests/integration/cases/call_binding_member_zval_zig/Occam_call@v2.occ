MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

MOBILE LIT FUNCTION obj.ZVal (VAL MOBILE LIT _arg)
    RESULT MOBILE LIT(lit.null)
:
PROC main ()
    VAL MOBILE LIT my_data IS obj.ZVal(MOBILE LIT(lit.int; 42)) // note:
    SEQ
        SKIP
:
