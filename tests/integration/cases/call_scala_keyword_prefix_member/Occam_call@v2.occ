MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

PROC Playlist.newValue (VAL MOBILE LIT x)
    SKIP
:
PROC main ()
    Playlist.newValue(MOBILE LIT(lit.int; 1))
    SEQ
        SKIP
:
