MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

PROC app.process.fetch (VAL MOBILE LIT data)
    SKIP
:
PROC main ()
    app.process.fetch(MOBILE LIT(lit.map; MOBILE []MOBILE LIT [MOBILE LIT(lit.pair; MOBILE []BYTE "data"; MOBILE LIT(lit.str; MOBILE []BYTE "hello"))]))
    app.process.fetch(MOBILE LIT(lit.map; MOBILE []MOBILE LIT [MOBILE LIT(lit.pair; MOBILE []BYTE "data"; MOBILE LIT(lit.int; 42))]))
    app.process.fetch(MOBILE LIT(lit.map; MOBILE []MOBILE LIT [MOBILE LIT(lit.pair; MOBILE []BYTE "data"; MOBILE LIT(lit.bool; TRUE))]))
    SEQ
        SKIP
:
