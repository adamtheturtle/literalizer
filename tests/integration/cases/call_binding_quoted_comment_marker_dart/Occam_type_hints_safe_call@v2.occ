MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

MOBILE LIT FUNCTION make_widget (VAL MOBILE LIT text)
    RESULT MOBILE LIT(lit.null)
:
PROC main ()
    VAL MOBILE LIT my_data IS make_widget(MOBILE LIT(lit.str; MOBILE []BYTE "first \"quote\"\n// string body")) // note
    // extra:
    SEQ
        SKIP
:
