MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

MOBILE LIT FUNCTION f (VAL MOBILE LIT a)
    RESULT MOBILE LIT(lit.null)
:
PROC main ()
    VAL MOBILE LIT ref_data IS 1:
    f(ref_data)
    SEQ
        SKIP
:
