MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

PROC check (VAL MOBILE LIT ts, VAL MOBILE LIT d)
    SKIP
:
PROC main ()
    check(MOBILE LIT(lit.str; MOBILE []BYTE "2024-01-15T10:30:00+00:00"), MOBILE LIT(lit.str; MOBILE []BYTE "2024-06-01"))
    SEQ
        SKIP
:
