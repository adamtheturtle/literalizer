MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

PROC main ()
    VAL MOBILE LIT my_data IS MOBILE LIT(lit.map; MOBILE []MOBILE LIT [
        MOBILE LIT(lit.pair; MOBILE []BYTE "morning"; MOBILE LIT(lit.str; MOBILE []BYTE "09:30:00")),
        MOBILE LIT(lit.pair; MOBILE []BYTE "afternoon"; MOBILE LIT(lit.str; MOBILE []BYTE "14:15:00")),
        MOBILE LIT(lit.pair; MOBILE []BYTE "evening"; MOBILE LIT(lit.str; MOBILE []BYTE "23:59:59"))
    ]):
    SEQ
        SKIP
:
