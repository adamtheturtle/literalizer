MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

PROC main ()
    VAL MOBILE LIT my_data IS MOBILE LIT(lit.map; MOBILE []MOBILE LIT [
        -- heading
        MOBILE LIT(lit.pair; MOBILE []BYTE "a"; MOBILE LIT(lit.str; MOBILE []BYTE "single ' // data")),
        MOBILE LIT(lit.pair; MOBILE []BYTE "b"; MOBILE LIT(lit.str; MOBILE []BYTE "linecontinuation")),
        MOBILE LIT(lit.pair; MOBILE []BYTE "c"; MOBILE LIT(lit.str; MOBILE []BYTE "\\")),  -- actual comment
        MOBILE LIT(lit.pair; MOBILE []BYTE "d"; MOBILE LIT(lit.str; MOBILE []BYTE "      "))  -- final comment
    ]):
    SEQ
        SKIP
:
