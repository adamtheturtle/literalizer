#+feature dynamic-literals
package main

main :: proc() {
my_data := map[string]any{
	"stamps" = [dynamic]any{"2001-02-03T04:05:06+00:00:01", "2001-02-03T04:05:06-00:00:01", "2001-02-03T04:05:06+00:00:00.000001", "2001-02-03T04:05:06-00:00:00.000001", "2001-02-03T04:05:06+05:30:15.000001", "2001-02-03T04:05:06-05:30:15.000001"},
}
_ = my_data
}
