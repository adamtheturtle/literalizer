MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

PROC main ()
    VAL MOBILE LIT my_data IS MOBILE LIT(lit.map; MOBILE []MOBILE LIT [
        -- A JSONC input case with both comment forms.
        MOBILE LIT(lit.pair; MOBILE []BYTE "url"; MOBILE LIT(lit.str; MOBILE []BYTE "https://example.org/a/*b*/")),  -- detail
        -- continued
        MOBILE LIT(lit.pair; MOBILE []BYTE "count"; MOBILE LIT(lit.int; 2))  -- trailing line comment
    ]):
    SEQ
        SKIP
:
