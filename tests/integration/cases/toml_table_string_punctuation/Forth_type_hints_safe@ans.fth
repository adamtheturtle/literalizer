: my_data
+obj
    s\" comma_hash" +key s\" a,#b" +str
    s\" comma_space_hash" +key s\" trail, # comment" +str
    s\" escaped_quote" +key s\" quote \" and , #" +str
    s\" next_line" +key s\" xy" +str
    s\" line_separator" +key s\" x y" +str
    s\" paragraph_separator" +key s\" x y" +str
 -obj
;
