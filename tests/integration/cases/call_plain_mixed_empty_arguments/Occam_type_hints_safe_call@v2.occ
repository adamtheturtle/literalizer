MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

MOBILE LIT FUNCTION make_widget (VAL MOBILE LIT before, VAL MOBILE LIT populated, VAL MOBILE LIT after)
    RESULT MOBILE LIT(lit.null)
:
PROC main ()
    make_widget(MOBILE LIT(lit.list; MOBILE []MOBILE LIT []), MOBILE LIT(lit.list; MOBILE []MOBILE LIT [MOBILE LIT(lit.int; 1)]), MOBILE LIT(lit.list; MOBILE []MOBILE LIT []))
    make_widget(MOBILE LIT(lit.list; MOBILE []MOBILE LIT [MOBILE LIT(lit.str; MOBILE []BYTE "text")]), MOBILE LIT(lit.list; MOBILE []MOBILE LIT [MOBILE LIT(lit.int; 2)]), MOBILE LIT(lit.list; MOBILE []MOBILE LIT []))
    make_widget(MOBILE LIT(lit.list; MOBILE []MOBILE LIT []), MOBILE LIT(lit.list; MOBILE []MOBILE LIT [MOBILE LIT(lit.str; MOBILE []BYTE "text")]), MOBILE LIT(lit.list; MOBILE []MOBILE LIT []))
    make_widget(MOBILE LIT(lit.list; MOBILE []MOBILE LIT [MOBILE LIT(lit.str; MOBILE []BYTE "text")]), MOBILE LIT(lit.list; MOBILE []MOBILE LIT [MOBILE LIT(lit.int; 2)]), MOBILE LIT(lit.list; MOBILE []MOBILE LIT [MOBILE LIT(lit.int; 3)]))
    SEQ
        SKIP
:
