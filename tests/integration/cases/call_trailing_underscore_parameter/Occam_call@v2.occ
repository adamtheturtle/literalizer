MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

PROC do_thing (VAL MOBILE LIT x_)
    SKIP
:
PROC main ()
    do_thing(MOBILE LIT(lit.int; 1))
    do_thing(MOBILE LIT(lit.int; 2))
    SEQ
        SKIP
:
