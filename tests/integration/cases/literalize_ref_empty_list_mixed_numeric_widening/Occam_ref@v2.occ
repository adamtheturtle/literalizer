MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

PROC main ()
    VAL MOBILE LIT EMPTY_VALUES IS MOBILE LIT(lit.list; MOBILE []MOBILE LIT []):
    VAL MOBILE LIT INTEGER_VALUES IS MOBILE LIT(lit.list; MOBILE []MOBILE LIT [
        MOBILE LIT(lit.int; 1)
    ]):
    VAL MOBILE LIT FLOAT_VALUES IS MOBILE LIT(lit.list; MOBILE []MOBILE LIT [
        MOBILE LIT(lit.float; 1.5(REAL64))
    ]):
    VAL MOBILE LIT my_data IS MOBILE LIT(lit.list; MOBILE []MOBILE LIT [
        EMPTY_VALUES,
        INTEGER_VALUES,
        FLOAT_VALUES
    ]):
    SEQ
        SKIP
:
