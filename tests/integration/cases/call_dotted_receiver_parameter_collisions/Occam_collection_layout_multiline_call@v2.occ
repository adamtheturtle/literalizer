MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

PROC api.worker.process (VAL MOBILE LIT self, VAL MOBILE LIT self_)
    SKIP
:
PROC main ()
    api.worker.process(MOBILE LIT(lit.map; MOBILE []MOBILE LIT []), MOBILE LIT(lit.map; MOBILE []MOBILE LIT []))
    SEQ
        SKIP
:
