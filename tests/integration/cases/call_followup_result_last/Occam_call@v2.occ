MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

MOBILE LIT FUNCTION make_widget (VAL MOBILE LIT first, VAL MOBILE LIT second)
    RESULT MOBILE LIT(lit.null)
:
PROC consume (VAL MOBILE LIT first, VAL MOBILE LIT second)
    SKIP
:
PROC main ()
    VAL MOBILE LIT my_data IS make_widget(MOBILE LIT(lit.int; 42), MOBILE LIT(lit.int; 3)):
    consume(MOBILE LIT(lit.int; 3), my_data)
    SEQ
        SKIP
:
