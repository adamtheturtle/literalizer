MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

PROC process (VAL MOBILE LIT data)
    SKIP
:
PROC main ()
    VAL MOBILE LIT my_list IS MOBILE LIT(lit.map; MOBILE []MOBILE LIT [
        MOBILE LIT(lit.pair; MOBILE []BYTE "unused"; MOBILE LIT(lit.str; MOBILE []BYTE "value"))
    ]):
    process(MOBILE LIT(lit.list; MOBILE []MOBILE LIT [MOBILE LIT(lit.list; MOBILE []MOBILE LIT [MOBILE LIT(lit.map; MOBILE []MOBILE LIT [MOBILE LIT(lit.pair; MOBILE []BYTE "inner"; my_list)])])]))
    SEQ
        SKIP
:
