MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

PROC main ()
    VAL MOBILE LIT my_data IS MOBILE LIT(lit.list; MOBILE []MOBILE LIT [
        MOBILE LIT(lit.str; MOBILE []BYTE "1970-01-01T00:00:00.000001+00:00"),
        MOBILE LIT(lit.str; MOBILE []BYTE "1969-12-31T23:59:59.500000+00:00"),
        MOBILE LIT(lit.str; MOBILE []BYTE "1970-01-01T00:00:01+00:00")
    ]):
    SEQ
        SKIP
:
