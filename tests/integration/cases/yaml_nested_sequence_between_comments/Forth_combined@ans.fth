\ This comment describes the last pair.
: my_data
+arr
    +arr +obj s\" item" +key s\" existing" +str -obj s\" kept" +str -arr
    +arr +obj s\" item" +key s\" next" +str -obj s\" also kept" +str -arr
    +arr +obj s\" item" +key s\" last" +str -obj s\" kept too" +str -arr
 -arr
;
