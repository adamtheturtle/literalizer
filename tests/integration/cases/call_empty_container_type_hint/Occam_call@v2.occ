MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

PROC process (VAL MOBILE LIT values, VAL MOBILE LIT count)
    SKIP
:
PROC main ()
    process(MOBILE LIT(lit.list; MOBILE []MOBILE LIT [MOBILE LIT(lit.int; 1), MOBILE LIT(lit.map; MOBILE []MOBILE LIT [])]), MOBILE LIT(lit.int; 42))
    SEQ
        SKIP
:
