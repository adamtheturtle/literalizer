MOBILE DATA TYPE LIT IS
  CASE
    lit.null
    lit.bool ; BOOL
    lit.int ; INT
    lit.float ; REAL64
    lit.str ; MOBILE []BYTE
    lit.list ; MOBILE []MOBILE LIT
    lit.map ; MOBILE []MOBILE LIT
    lit.pair ; MOBILE []BYTE ; MOBILE LIT
    lit.set ; MOBILE []MOBILE LIT
:

PROC f (VAL MOBILE LIT a)
    SKIP
:
PROC main ()
    -- scalar heading
    -- second heading line
    -- scalar inline
    -- inline continuation
    -- scalar trailing
    f(MOBILE LIT(lit.int; 42))
    SEQ
        SKIP
:
